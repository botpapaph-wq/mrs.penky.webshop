# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# PayMongo (Local Development + Production)
PAYMONGO_SECRET_KEY=sk_live_...
PAYMONGO_WEBHOOK_SECRET=whsk_...

# PayPal (international payments -- Stripe does not support PH-based businesses)
PAYPAL_ENV=sandbox            # "live" once tested; defaults to sandbox if unset
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_CLIENT_SECRET
PAYPAL_WEBHOOK_ID=YOUR_PAYPAL_WEBHOOK_ID

# Zoho Books (for automatic invoicing)
ZOHO_ACCESS_TOKEN=YOUR_ZOHO_ACCESS_TOKEN
ZOHO_REFRESH_TOKEN=YOUR_ZOHO_REFRESH_TOKEN
ZOHO_ORGANIZATION_ID=932735549

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=YOUR_ACCOUNT_ID
CLOUDFLARE_ZONE_ID=YOUR_ZONE_ID
CLOUDFLARE_API_TOKEN=YOUR_API_TOKEN

# Domain
DOMAIN=mrs.penky.com
