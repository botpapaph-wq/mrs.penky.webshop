# Cloudflare Pages header rules.
#
# Why this file exists: after a deployment the site was still serving an older
# chat-widget.js and an older checkout.html while index.html was current, so a
# fixed bug looked unfixed. HTML must always be revalidated; the versioned
# ?v= query string on scripts then decides when a browser picks up new JS.

/*.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/
  Cache-Control: public, max-age=0, must-revalidate

# Scripts and styles are requested with an explicit ?v= version, so a long
# cache is safe: a new version is a new URL.
/*.js
  Cache-Control: public, max-age=3600, must-revalidate

/*.css
  Cache-Control: public, max-age=3600, must-revalidate

/*.png
  Cache-Control: public, max-age=604800

/robots.txt
  Cache-Control: public, max-age=0, must-revalidate

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate
